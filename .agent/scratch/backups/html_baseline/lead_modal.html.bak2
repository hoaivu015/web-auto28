<!-- 💻 MODAL CHI TIẾT XE -->
<div class="expressive-modal" id="car-modal-view" role="dialog" aria-modal="true" aria-labelledby="modal-car-title" aria-hidden="true">
    <div class="modal-overlay" id="modal-overlay"></div>
    <div class="modal-wrapper">
        <div class="modal-drag-indicator" id="modal-drag-indicator" title="Vuốt xuống để đóng"></div>
        <button class="modal-close" id="modal-close-btn" aria-label="Đóng cửa sổ chi tiết xe">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        <div class="modal-content-inner">
            <div class="modal-visual-panel">
                <div class="modal-image-wrapper">
                    <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 10'%3E%3C/svg%3E" alt="Car Detail" class="modal-active-img" id="modal-display-img">
                </div>
            </div>

            <div class="modal-info-panel">
                <div class="modal-header">
                    <span class="modal-meta-line" id="modal-car-class">SUV 5 CHỖ · ĐỜI 2023</span>
                    <h2 class="modal-car-title" id="modal-car-title">VinFast VF 8 Plus</h2>
                    <div class="modal-price-line">
                        <span class="modal-price-label">Giá ưu đãi:</span>
                        <span class="modal-price-value" id="modal-car-price">745 Triệu</span>
                    </div>

                    <!-- 🔥 Scarcity Urgency Badge -->
                    <div class="modal-scarcity-badge" id="modal-scarcity-badge">🎁 Ưu đãi độc quyền: Hỗ trợ thủ tục sang tên trọn gói</div>
                </div>

                <!-- Bento Micro-Cards Spec Grid -->
                <ul class="modal-specs-bento-grid">
                    <li class="bento-spec-card"><span class="spec-card-icon">⏱️</span><div class="spec-card-text"><span class="spec-card-label">Số Odo</span><strong id="modal-spec-odo">15,000 km</strong></div></li>
                    <li class="bento-spec-card"><span class="spec-card-icon">🎨</span><div class="spec-card-text"><span class="spec-card-label">Màu sơn</span><strong id="modal-spec-color">Màu Bạc</strong></div></li>
                    <li class="bento-spec-card"><span class="spec-card-icon">📍</span><div class="spec-card-text"><span class="spec-card-label">Biển số</span><strong id="modal-spec-plate">Biển Hà Nội</strong></div></li>
                    <li class="bento-spec-card"><span class="spec-card-icon">🔋</span><div class="spec-card-text"><span class="spec-card-label">Pin xe</span><strong id="modal-spec-battery">Thuê pin (SOH 95%)</strong></div></li>
                    <li class="bento-spec-card bento-spec-card--full"><span class="spec-card-icon">🛡️</span><div class="spec-card-text"><span class="spec-card-label">Bảo hành</span><strong>Cam kết bảo hành chính hãng từ VinFast</strong></div></li>
                </ul>

                <div class="modal-action-box" id="modal-action-box">
                    <p class="action-box-title" style="text-align: center; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.75rem; color: #0f172a;">Đăng ký lái thử &amp; Nhận báo giá lăn bánh</p>
                    <form id="lead-form" style="display: flex; flex-direction: column; gap: 0.625rem; width: 100%;">
                        <!-- 🛡️ ANTI-BOT HONEYPOT FIELD (Hidden from real users, traps automated spam bots) -->
                        <input type="text" name="hp_company_field" id="modal-hp-field" style="display:none !important; position:absolute; left:-9999px; width:0; height:0;" tabindex="-1" autocomplete="off">

                        <input type="text" id="modal-name" name="fullname" placeholder="Họ và tên của bạn" class="modal-pill-input" required autocomplete="name">
                        <input type="tel" id="modal-phone" name="phone" placeholder="Số điện thoại liên hệ (10 số)" class="modal-tel-input" required autocomplete="tel" maxlength="13">
                        <span class="modal-input-feedback" id="modal-phone-feedback"></span>
                        
                        <p class="action-box-trust" style="text-align: center; font-size: 0.75rem; color: #475569; font-weight: 600; margin: 4px 0 6px;">🔒 Auto28 bảo mật 100% thông tin &amp; tư vấn miễn phí.</p>

                        
                        <button type="submit" class="btn-modal-submit" id="btn-modal-action-submit">⚡ NHẬN ƯU ĐÃI NGAY ➜</button>
                    </form>

                    <!-- Instant Quick Actions with Touch Spacing Safety Zone -->
                    <div class="modal-quick-actions" style="margin-top: 12px; display: flex; gap: 8px;">
                        <a href="tel:0888813838" class="btn-quick-action btn-quick-call" id="btn-quick-call" style="flex: 1; text-align: center; text-decoration: none; padding: 10px 14px; border-radius: 9999px; background: rgba(37, 99, 235, 0.08); color: #2563eb; font-weight: 700; font-size: 0.85rem; border: 1px solid rgba(37, 99, 235, 0.2); transition: all 0.2s ease;">📞 Gọi Hotline</a>
                        <a href="https://zalo.me/0888813838" target="_blank" rel="noopener" class="btn-quick-action btn-quick-zalo" id="btn-quick-zalo" style="flex: 1; text-align: center; text-decoration: none; padding: 10px 14px; border-radius: 9999px; background: rgba(16, 185, 129, 0.08); color: #059669; font-weight: 700; font-size: 0.85rem; border: 1px solid rgba(16, 185, 129, 0.2); transition: all 0.2s ease;">💬 Chat Zalo Xe</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>