{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/showroom", "destination": "/index.html" },
    { "source": "/dinh-gia", "destination": "/dinh-gia-ban-xe.html" },
    { "source": "/dinh-gia-ban-xe", "destination": "/dinh-gia-ban-xe.html" },
    { "source": "/sell", "destination": "/dinh-gia-ban-xe.html" },
    { "source": "/huong-dan", "destination": "/huong-dan-phap-ly.html" },
    { "source": "/huong-dan-phap-ly", "destination": "/huong-dan-phap-ly.html" },
    { "source": "/huong-dan-mua-xe-dien", "destination": "/huong-dan-mua-xe-dien.html" },
    { "source": "/studio", "destination": "/auto28-studio.html" },
    { "source": "/auto28-studio", "destination": "/auto28-studio.html" },
    { "source": "/vf3", "destination": "/index.html?filter=vf3#product-grid-section" },
    { "source": "/vf5", "destination": "/index.html?filter=vf5#product-grid-section" },
    { "source": "/vf6", "destination": "/index.html?filter=vf6#product-grid-section" },
    { "source": "/vf7", "destination": "/index.html?filter=vf7#product-grid-section" },
    { "source": "/vf8", "destination": "/index.html?filter=vf8#product-grid-section" },
    { "source": "/vf9", "destination": "/index.html?filter=vf9#product-grid-section" },
    { "source": "/vfe34", "destination": "/index.html?filter=vfe34#product-grid-section" },
    { "source": "/lux-a", "destination": "/index.html?filter=lux-a#product-grid-section" },
    { "source": "/lux-sa", "destination": "/index.html?filter=lux-sa#product-grid-section" },
    { "source": "/fadil", "destination": "/index.html?filter=fadil#product-grid-section" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|woff2|svg|gif|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
