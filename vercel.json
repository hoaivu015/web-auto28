{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/showroom", "dest": "/index.html" },
    { "src": "/dinh-gia", "dest": "/sell.html" },
    { "src": "/sell", "dest": "/sell.html" },
    { "src": "/huong-dan", "dest": "/guide.html" },
    { "src": "/huong-dan-mua-xe-dien", "dest": "/guide-ev.html" },
    { "src": "/huong-dan-mua-xe-dien.html", "dest": "/guide-ev.html" },
    { "src": "/studio", "dest": "/auto28-studio.html" },
    { "src": "/auto28-studio", "dest": "/auto28-studio.html" },
    { "src": "/vf3", "dest": "/index.html?filter=vf3#product-grid-section" },
    { "src": "/vf5", "dest": "/index.html?filter=vf5#product-grid-section" },
    { "src": "/vf6", "dest": "/index.html?filter=vf6#product-grid-section" },
    { "src": "/vf7", "dest": "/index.html?filter=vf7#product-grid-section" },
    { "src": "/vf8", "dest": "/index.html?filter=vf8#product-grid-section" },
    { "src": "/vf9", "dest": "/index.html?filter=vf9#product-grid-section" },
    { "src": "/vfe34", "dest": "/index.html?filter=vfe34#product-grid-section" },
    { "src": "/lux-a", "dest": "/index.html?filter=lux-a#product-grid-section" },
    { "src": "/lux-sa", "dest": "/index.html?filter=lux-sa#product-grid-section" },
    { "src": "/fadil", "dest": "/index.html?filter=fadil#product-grid-section" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    }
  ]
}
